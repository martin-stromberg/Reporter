<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Reporter.Core.Resources.Strings;assembly=Reporter.Core"
             xmlns:views="clr-namespace:Reporter.Views;assembly=Reporter"
             xmlns:models="clr-namespace:Reporter.Core.Models;assembly=Reporter.Core"
             x:Name="PageRoot"
             x:Class="Reporter.Views.UnreadPage"
             Title="{x:Static strings:AppResources.PageTitleUnread}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*"
          Padding="16,8"
          RowSpacing="12">
        <VerticalStackLayout Spacing="8">
            <Label Text="{x:Static strings:AppResources.PageTitleUnread}"
                   Style="{StaticResource HeadlineStyle}"/>

            <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                  ColumnSpacing="12"
                  RowDefinitions="Auto">
                <Border Grid.Column="0"
                        WidthRequest="44"
                        HeightRequest="44"
                        StrokeShape="RoundRectangle 22"
                        Background="{AppThemeBinding Light={StaticResource LightSurfaceContainer}, Dark={StaticResource DarkSurfaceContainer}}"
                        VerticalOptions="Center">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsOnline}" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding RefreshCommand}"/>
                    </Border.GestureRecognizers>
                    <Path Data="M24,4 A20,20 0 1,1 24,44 A20,20 0 1,1 24,4 Z M24,32 L32,24 M24,32 L16,24"
                          Stroke="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                          StrokeThickness="2"
                          StrokeLineCap="Round"
                          StrokeLineJoin="Round"
                          Aspect="Uniform"
                          WidthRequest="24"
                          HeightRequest="24"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"
                          Fill="Transparent">
                        <Path.Triggers>
                            <DataTrigger TargetType="Path" Binding="{Binding IsOnline}" Value="False">
                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"/>
                            </DataTrigger>
                        </Path.Triggers>
                    </Path>
                </Border>

                <Border Grid.Column="1"
                        WidthRequest="44"
                        HeightRequest="44"
                        StrokeShape="RoundRectangle 22"
                        Background="{AppThemeBinding Light={StaticResource LightSurfaceContainer}, Dark={StaticResource DarkSurfaceContainer}}"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterClicked"/>
                    </Border.GestureRecognizers>
                    <Path Data="M12,10 L36,10 L28,22 L28,34 L20,42 L20,22 Z"
                          Fill="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                          Aspect="Uniform"
                          WidthRequest="24"
                          HeightRequest="24"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Grid.Column="2"
                                     Spacing="2"
                                     VerticalOptions="Center">
                    <Label Text="{Binding UnreadCountText}"
                           Style="{StaticResource BodySmallStyle}"/>
                    <Label Text="{x:Static strings:AppResources.LabelPullToRefresh}"
                           Style="{StaticResource MetaStyle}"/>
                    <Label Text="{x:Static strings:AppResources.OfflineHint}"
                           Style="{StaticResource MetaStyle}"
                           TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                           IsVisible="False">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsOnline}" Value="False">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>

                <Border Grid.Column="3"
                        Padding="12,8"
                        StrokeShape="RoundRectangle 22"
                        Background="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}"
                        MinimumHeightRequest="44"
                        MinimumWidthRequest="44"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding MarkAllReadCommand}"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6"
                                           VerticalOptions="Center">
                        <Path Data="M4,18 L12,26 L24,14 M16,18 L24,26 L36,14"
                              Stroke="{AppThemeBinding Light={StaticResource LightOnPrimary}, Dark={StaticResource DarkOnPrimary}}"
                              StrokeThickness="2"
                              StrokeLineCap="Round"
                              StrokeLineJoin="Round"
                              Aspect="Uniform"
                              WidthRequest="20"
                              HeightRequest="20"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Fill="Transparent"/>
                        <Label Text="{x:Static strings:AppResources.ButtonMarkAllRead}"
                               TextColor="{AppThemeBinding Light={StaticResource LightOnPrimary}, Dark={StaticResource DarkOnPrimary}}"
                               FontSize="12"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <Label Text="{Binding SelectedCategoryText}"
                   Style="{StaticResource MetaStyle}"/>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{AppThemeBinding Light={StaticResource LightError}, Dark={StaticResource DarkError}}"
                   IsVisible="{Binding HasError}"
                   Style="{StaticResource BodySmallStyle}"/>

            <Label Text="{Binding SyncErrorMessage}"
                   TextColor="{AppThemeBinding Light={StaticResource LightError}, Dark={StaticResource DarkError}}"
                   IsVisible="{Binding HasSyncError}"
                   Style="{StaticResource BodySmallStyle}"/>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsSyncing}"
                     Command="{Binding RefreshCommand}">
            <CollectionView x:Name="ArticlesCollection"
                            ItemsSource="{Binding Articles}"
                            RemainingItemsThreshold="2"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                            EmptyView="{x:Static strings:AppResources.PlaceholderUnread}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ItemListItem">
                        <views:ArticleCardView ToggleSavedCommand="{Binding BindingContext.ToggleSavedCommand, Source={x:Reference PageRoot}}"
                                               MarkReadCommand="{Binding BindingContext.MarkReadCommand, Source={x:Reference PageRoot}}"
                                               IsOnline="{Binding BindingContext.IsOnline, Source={x:Reference PageRoot}}"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           VerticalOptions="End"
                           HorizontalOptions="Center"/>
    </Grid>
</ContentPage>
