<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Reporter.Core.Resources.Strings;assembly=Reporter.Core"
             x:Class="Reporter.Views.UnreadPage"
             Title="{Binding Title}">
    <VerticalStackLayout Spacing="20" Padding="20">
        <Label Text="{Binding Title}"
               Style="{StaticResource HeadlineStyle}"
               HorizontalOptions="Center" />
        <Label Text="{x:Static strings:AppResources.PlaceholderUnread}"
               Style="{StaticResource BodySmallStyle}"
               HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>
