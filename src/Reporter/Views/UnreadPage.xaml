<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Reporter.Core.Resources.Strings;assembly=Reporter.Core"
             x:Name="PageRoot"
             x:Class="Reporter.Views.UnreadPage"
             Title="{x:Static strings:AppResources.PageTitleUnread}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*"
          Padding="16,8"
          RowSpacing="12">
        <VerticalStackLayout Spacing="8">
            <Label Text="{x:Static strings:AppResources.PageTitleUnread}"
                   Style="{StaticResource HeadlineStyle}"/>

            <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                  ColumnSpacing="12"
                  RowDefinitions="Auto">
                <Border Grid.Column="0"
                        WidthRequest="44"
                        HeightRequest="44"
                        StrokeShape="RoundRectangle 22"
                        Background="{AppThemeBinding Light={StaticResource LightSurfaceContainer}, Dark={StaticResource DarkSurfaceContainer}}"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding RefreshCommand}"/>
                    </Border.GestureRecognizers>
                    <Path Data="M24,4 A20,20 0 1,1 24,44 A20,20 0 1,1 24,4 Z M24,32 L32,24 M24,32 L16,24"
                          Stroke="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                          StrokeThickness="2"
                          StrokeLineCap="Round"
                          StrokeLineJoin="Round"
                          Aspect="Uniform"
                          WidthRequest="24"
                          HeightRequest="24"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"
                          Fill="Transparent"/>
                </Border>

                <Border Grid.Column="1"
                        WidthRequest="44"
                        HeightRequest="44"
                        StrokeShape="RoundRectangle 22"
                        Background="{AppThemeBinding Light={StaticResource LightSurfaceContainer}, Dark={StaticResource DarkSurfaceContainer}}"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterClicked"/>
                    </Border.GestureRecognizers>
                    <Path Data="M12,10 L36,10 L28,22 L28,34 L20,42 L20,22 Z"
                          Fill="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                          Aspect="Uniform"
                          WidthRequest="24"
                          HeightRequest="24"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Grid.Column="2"
                                     Spacing="2"
                                     VerticalOptions="Center">
                    <Label Text="{Binding UnreadCountText}"
                           Style="{StaticResource BodySmallStyle}"/>
                    <Label Text="{x:Static strings:AppResources.LabelPullToRefresh}"
                           Style="{StaticResource MetaStyle}"/>
                </VerticalStackLayout>

                <Border Grid.Column="3"
                        Padding="12,8"
                        StrokeShape="RoundRectangle 22"
                        Background="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding MarkAllReadCommand}"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6"
                                           VerticalOptions="Center">
                        <Path Data="M4,18 L12,26 L24,14 M16,18 L24,26 L36,14"
                              Stroke="{AppThemeBinding Light={StaticResource LightOnPrimary}, Dark={StaticResource DarkOnPrimary}}"
                              StrokeThickness="2"
                              StrokeLineCap="Round"
                              StrokeLineJoin="Round"
                              Aspect="Uniform"
                              WidthRequest="20"
                              HeightRequest="20"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Fill="Transparent"/>
                        <Label Text="{x:Static strings:AppResources.ButtonMarkAllRead}"
                               TextColor="{AppThemeBinding Light={StaticResource LightOnPrimary}, Dark={StaticResource DarkOnPrimary}}"
                               FontSize="12"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <Label Text="{Binding SelectedCategoryText}"
                   Style="{StaticResource MetaStyle}"/>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsSyncing}"
                     Command="{Binding RefreshCommand}">
            <CollectionView x:Name="ArticlesCollection"
                            ItemsSource="{Binding Articles}"
                            RemainingItemsThreshold="2"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                            EmptyView="{x:Static strings:AppResources.PlaceholderUnread}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16"
                                Margin="0,6"
                                StrokeShape="RoundRectangle 16"
                                Background="{AppThemeBinding Light={StaticResource LightSurfaceCard}, Dark={StaticResource DarkSurfaceCard}}"
                                Stroke="{AppThemeBinding Light={StaticResource LightOutline}, Dark={StaticResource DarkOutline}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnArticleTapped"
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="*,Auto"
                                  RowSpacing="10"
                                  ColumnSpacing="14">
                                <HorizontalStackLayout Grid.Row="0"
                                                       Grid.Column="0"
                                                       Spacing="8"
                                                       VerticalOptions="Center">
                                    <BoxView WidthRequest="8"
                                             HeightRequest="8"
                                             CornerRadius="4"
                                             BackgroundColor="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}"
                                             VerticalOptions="Center"/>
                                    <Label Text="{Binding FeedTitle}"
                                           Style="{StaticResource BodySmallStyle}"
                                           VerticalOptions="Center"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1"/>
                                    <Label Text="•"
                                           Style="{StaticResource MetaStyle}"
                                           VerticalOptions="Center"/>
                                    <Label Text="{Binding PublishedAt, StringFormat='{0:g}', TargetNullValue='—'}"
                                           Style="{StaticResource MetaStyle}"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <Border Grid.Row="0"
                                        Grid.Column="1"
                                        Padding="8,3"
                                        StrokeShape="RoundRectangle 10"
                                        Background="{AppThemeBinding Light={StaticResource LightSurfaceContainer}, Dark={StaticResource DarkSurfaceContainer}}"
                                        VerticalOptions="Center">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding CategoryName}" Value="">
                                            <Setter Property="IsVisible" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding CategoryName}" Value="{x:Null}">
                                            <Setter Property="IsVisible" Value="False"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding CategoryName}"
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                           VerticalOptions="Center"
                                           FontAttributes="Bold"/>
                                </Border>

                                <Label Grid.Row="1"
                                       Grid.Column="0"
                                       Text="{Binding Title}"
                                       Style="{StaticResource HeadlineSmallStyle}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2"
                                       VerticalOptions="Start"/>

                                <Border Grid.Row="1"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        WidthRequest="80"
                                        HeightRequest="80"
                                        StrokeShape="RoundRectangle 12"
                                        Background="{AppThemeBinding Light={StaticResource LightSurfaceContainer}, Dark={StaticResource DarkSurfaceContainer}}"
                                        VerticalOptions="Start">
                                    <Image Source="{Binding ImageUrl}"
                                           Aspect="AspectFill"
                                           WidthRequest="80"
                                           HeightRequest="80"/>
                                </Border>

                                <Label Grid.Row="2"
                                       Grid.Column="0"
                                       Text="{Binding Summary}"
                                       Style="{StaticResource BodySmallStyle}"
                                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2"
                                       IsVisible="{Binding Summary, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                                       VerticalOptions="Start"/>

                                <Grid Grid.Row="3"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="2"
                                      ColumnDefinitions="*,Auto"
                                      RowDefinitions="Auto">
                                    <HorizontalStackLayout Grid.Column="0"
                                                           Spacing="4"
                                                           VerticalOptions="Center">
                                        <Path Data="M24,4 A20,20 0 1,1 24,44 A20,20 0 1,1 24,4 Z M24,14 L24,26 M24,26 L18,20 M24,26 L30,20"
                                              Stroke="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                              StrokeThickness="2"
                                              StrokeLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Aspect="Uniform"
                                              WidthRequest="16"
                                              HeightRequest="16"
                                              VerticalOptions="Center"
                                              Fill="Transparent"/>
                                        <Label Text="—"
                                               Style="{StaticResource MetaStyle}"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Grid.Column="1"
                                                           Spacing="8"
                                                           VerticalOptions="Center">
                                        <Border WidthRequest="44"
                                                HeightRequest="44"
                                                StrokeShape="RoundRectangle 22"
                                                Background="Transparent"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.ToggleSavedCommand, Source={x:Reference PageRoot}}"
                                                                      CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                            <Path Data="M6,4 L22,4 L22,26 L14,20 L6,26 Z"
                                                  Stroke="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                                                  StrokeThickness="2"
                                                  StrokeLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Aspect="Uniform"
                                                  WidthRequest="18"
                                                  HeightRequest="18"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Fill="Transparent"/>
                                        </Border>

                                        <Border WidthRequest="44"
                                                HeightRequest="44"
                                                StrokeShape="RoundRectangle 22"
                                                Background="Transparent"
                                                VerticalOptions="Center">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.MarkReadCommand, Source={x:Reference PageRoot}}"
                                                                      CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                            <Path Data="M4,14 L12,22 L26,8"
                                                  Stroke="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                                                  StrokeThickness="2"
                                                  StrokeLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Aspect="Uniform"
                                                  WidthRequest="18"
                                                  HeightRequest="18"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Fill="Transparent"/>
                                        </Border>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           VerticalOptions="End"
                           HorizontalOptions="Center"/>
    </Grid>
</ContentPage>
