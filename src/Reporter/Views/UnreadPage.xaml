<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Reporter.Core.Resources.Strings;assembly=Reporter.Core"
             xmlns:views="clr-namespace:Reporter.Views;assembly=Reporter"
             xmlns:models="clr-namespace:Reporter.Core.Models;assembly=Reporter.Core"
             xmlns:vm="clr-namespace:Reporter.Core.ViewModels;assembly=Reporter.Core"
             x:Name="PageRoot"
             x:Class="Reporter.Views.UnreadPage"
             x:DataType="vm:UnreadViewModel"
             Title="{x:Static strings:AppResources.PageTitleUnread}"
             Shell.NavBarIsVisible="False">
    <Grid x:Name="LayoutRoot"
          RowDefinitions="Auto,Auto,Auto,*">

        <!-- ═════════ Header: Datum + Aktionen, Display-Titel, Status ═════════ -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="20,8,16,0"
                             Spacing="2">
            <Grid ColumnDefinitions="*,Auto"
                  MinimumHeightRequest="44">
                <Label Text="{Binding HeaderDateText}"
                       Style="{StaticResource EyebrowStyle}"
                       VerticalOptions="Center"/>

                <HorizontalStackLayout Grid.Column="1"
                                       Spacing="0"
                                       Margin="0,0,-6,0">
                    <Border x:Name="RefreshButton"
                            Style="{StaticResource IconButtonStyle}"
                            SemanticProperties.Description="{x:Static strings:AppResources.ButtonRefresh}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsOnline}" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RefreshCommand}"/>
                        </Border.GestureRecognizers>
                        <Path x:Name="RefreshIcon"
                              Style="{StaticResource IconPathStyle}"
                              Data="M21,12 A9,9 0 1,1 18.36,5.64 M21,3 L21,9 L15,9"
                              Scale="0.85"
                              StrokeThickness="1.9"/>
                    </Border>

                    <Border Style="{StaticResource IconButtonStyle}"
                            SemanticProperties.Description="{Binding LayoutToggleDescription}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLayoutToggleTapped"/>
                        </Border.GestureRecognizers>
                        <Grid InputTransparent="True">
                            <Path Style="{StaticResource IconPathStyle}"
                                  Data="M6,3 L18,3 A2,2 0 0,1 20,5 L20,15 A2,2 0 0,1 18,17 L6,17 A2,2 0 0,1 4,15 L4,5 A2,2 0 0,1 6,3 Z M8,21 L16,21"
                                  Scale="0.8"
                                  StrokeThickness="2"
                                  IsVisible="{Binding IsListLayout}"/>
                            <Path Style="{StaticResource IconPathStyle}"
                                  Data="M9,6 L20,6 M9,12 L20,12 M9,18 L20,18 M4,6 L4.01,6 M4,12 L4.01,12 M4,18 L4.01,18"
                                  Scale="0.8"
                                  StrokeThickness="2.2"
                                  IsVisible="{Binding IsCardLayout}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource IconButtonStyle}"
                            SemanticProperties.Description="{x:Static strings:AppResources.ButtonMarkAllRead}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMarkAllReadTapped"/>
                        </Border.GestureRecognizers>
                        <Path Style="{StaticResource IconPathStyle}"
                              Data="M18,6 L7,17 L2,12 M22,10 L14.5,17.5 L13,16"
                              Scale="0.8"
                              StrokeThickness="2"/>
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <Label Text="{x:Static strings:AppResources.PageTitleUnread}"
                   Style="{StaticResource DisplayTitleStyle}"
                   SemanticProperties.HeadingLevel="Level1"
                   Margin="0,2,0,0"/>

            <HorizontalStackLayout Spacing="8"
                                   Margin="0,6,0,0">
                <Ellipse x:Name="StatusDot"
                         WidthRequest="7"
                         HeightRequest="7"
                         VerticalOptions="Center"
                         Fill="{AppThemeBinding Light={StaticResource LightStatusOk}, Dark={StaticResource DarkStatusOk}}">
                    <Ellipse.Triggers>
                        <DataTrigger TargetType="Ellipse" Binding="{Binding HasSyncError}" Value="True">
                            <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource LightStatusError}, Dark={StaticResource DarkStatusError}}"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Ellipse" Binding="{Binding IsSyncing}" Value="True">
                            <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource LightStatusWarning}, Dark={StaticResource DarkStatusWarning}}"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Ellipse" Binding="{Binding IsOnline}" Value="False">
                            <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}"/>
                        </DataTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <Label Text="{Binding UnreadBadgeText}"
                       Style="{StaticResource MetaStrongStyle}"
                       VerticalOptions="Center"/>
                <Label Text="·"
                       Style="{StaticResource MetaStyle}"
                       VerticalOptions="Center"
                       IsVisible="{Binding SyncStatusText, Converter={StaticResource StringNotEmptyToBoolConverter}}"/>
                <Label Text="{Binding SyncStatusText}"
                       Style="{StaticResource MetaStyle}"
                       VerticalOptions="Center"
                       IsVisible="{Binding SyncStatusText, Converter={StaticResource StringNotEmptyToBoolConverter}}"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- ═════════ Animierte Filter-Tabs ═════════ -->
        <views:CategoryFilterTabs Grid.Row="1"
                                  Margin="0,14,0,4"
                                  ItemsSource="{Binding Categories}"
                                  SelectCommand="{Binding BindingContext.SelectCategoryCommand, Source={x:Reference PageRoot}}"/>

        <!-- ═════════ Fehlerhinweise ═════════ -->
        <VerticalStackLayout Grid.Row="2"
                             Padding="16,4,16,0"
                             Spacing="6">
            <Border Padding="14,10"
                    StrokeThickness="0"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 14"
                    Background="{AppThemeBinding Light={StaticResource LightStatusErrorTint}, Dark={StaticResource DarkStatusErrorTint}}"
                    IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}"
                       Style="{StaticResource BodySmallStyle}"
                       TextColor="{AppThemeBinding Light={StaticResource LightStatusErrorText}, Dark={StaticResource DarkStatusErrorText}}"/>
            </Border>
            <Border Padding="14,10"
                    StrokeThickness="0"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 14"
                    Background="{AppThemeBinding Light={StaticResource LightStatusErrorTint}, Dark={StaticResource DarkStatusErrorTint}}"
                    IsVisible="{Binding HasSyncError}">
                <Label Text="{Binding SyncErrorMessage}"
                       Style="{StaticResource BodySmallStyle}"
                       TextColor="{AppThemeBinding Light={StaticResource LightStatusErrorText}, Dark={StaticResource DarkStatusErrorText}}"/>
            </Border>
        </VerticalStackLayout>

        <!-- ═════════ Inhalt ═════════ -->
        <Grid x:Name="ContentHost"
              Grid.Row="3">

            <!-- Variante 1: Scroll-Liste -->
            <RefreshView x:Name="ListHost"
                         IsVisible="{Binding IsListLayout}"
                         IsRefreshing="{Binding IsSyncing}"
                         Command="{Binding RefreshCommand}">
                <CollectionView x:Name="ArticlesCollection"
                                ItemsSource="{Binding Articles}"
                                RemainingItemsThreshold="4"
                                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                    <CollectionView.Triggers>
                        <DataTrigger TargetType="CollectionView" Binding="{Binding IsCardLayout}" Value="True">
                            <Setter Property="ItemsSource" Value="{x:Null}"/>
                        </DataTrigger>
                    </CollectionView.Triggers>
                    <CollectionView.Header>
                        <BoxView HeightRequest="4"
                                 Color="Transparent"
                                 BackgroundColor="Transparent"/>
                    </CollectionView.Header>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ItemListItem">
                            <views:ArticleRowView ToggleSavedCommand="{Binding BindingContext.ToggleSavedCommand, Source={x:Reference PageRoot}}"
                                                  MarkReadCommand="{Binding BindingContext.MarkReadCommand, Source={x:Reference PageRoot}}"
                                                  IsOnline="{Binding BindingContext.IsOnline, Source={x:Reference PageRoot}}"/>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.Footer>
                        <Grid Padding="0,12,0,32">
                            <ActivityIndicator IsRunning="{Binding IsLoading}"
                                               IsVisible="{Binding HasArticles}"
                                               WidthRequest="22"
                                               HeightRequest="22"
                                               HorizontalOptions="Center">
                                <ActivityIndicator.Triggers>
                                    <DataTrigger TargetType="ActivityIndicator" Binding="{Binding IsLoading}" Value="False">
                                        <Setter Property="IsVisible" Value="False"/>
                                    </DataTrigger>
                                </ActivityIndicator.Triggers>
                            </ActivityIndicator>
                        </Grid>
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>

            <!-- Variante 2: Karten-Triage -->
            <Grid x:Name="CardsHost"
                  RowDefinitions="*,Auto"
                  IsVisible="{Binding IsCardLayout}">
                <!-- Kartenstapel: oben die aktuelle Karte, dahinter die nächste -->
                <Grid x:Name="CardStage"
                      Grid.Row="0"
                      Margin="20,10,20,6">
                    <views:ArticleHeroCardView x:Name="BackCard"
                                               BindingContext="{Binding NextCard}"
                                               IsOnline="{Binding BindingContext.IsOnline, Source={x:Reference PageRoot}}"
                                               InputTransparent="True"
                                               Margin="0,0,0,14"
                                               Scale="0.93"
                                               TranslationY="26"
                                               Opacity="0.55"
                                               IsVisible="{Binding BindingContext.NextCard, Source={x:Reference PageRoot}, Converter={StaticResource IsNotNullConverter}}"/>
                    <views:ArticleHeroCardView x:Name="FrontCard"
                                               Margin="0,0,0,14"
                                               BindingContext="{Binding CurrentCard}"
                                               IsOnline="{Binding BindingContext.IsOnline, Source={x:Reference PageRoot}}"
                                               IsVisible="{Binding BindingContext.HasArticles, Source={x:Reference PageRoot}}"/>
                </Grid>

                <!-- Aktionsleiste -->
                <VerticalStackLayout Grid.Row="1"
                                     Padding="0,0,0,12"
                                     Spacing="8"
                                     IsVisible="{Binding HasArticles}">
                    <Label Text="{Binding CardPositionText}"
                           Style="{StaticResource EyebrowStyle}"
                           HorizontalOptions="Center"/>

                    <HorizontalStackLayout Spacing="14"
                                           HorizontalOptions="Center">
                        <Border Style="{StaticResource IconButtonStyle}"
                                SemanticProperties.Description="{x:Static strings:AppResources.UnreadCardPrevious}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding CanGoToPreviousCard}" Value="False">
                                    <Setter Property="Opacity" Value="0.3"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCardPreviousTapped"/>
                            </Border.GestureRecognizers>
                            <Path Style="{StaticResource IconPathStyle}"
                                  Data="M15,18 L9,12 L15,6"
                                  StrokeThickness="2"
                                  Stroke="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"/>
                        </Border>

                        <Border x:Name="CardSaveButton"
                                Style="{StaticResource IconButtonFilledStyle}"
                                WidthRequest="56"
                                HeightRequest="56"
                                StrokeShape="RoundRectangle 28"
                                SemanticProperties.Description="{x:Static strings:AppResources.ArticleBookmarkSet}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding CurrentCard.IsSavedForLater}" Value="True">
                                    <Setter Property="SemanticProperties.Description" Value="{x:Static strings:AppResources.ArticleBookmarkRemove}"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCardSaveTapped"/>
                            </Border.GestureRecognizers>
                            <Path Style="{StaticResource IconPathStyle}"
                                  Data="M19,21 L12,16 L5,21 L5,5 A2,2 0 0,1 7,3 L17,3 A2,2 0 0,1 19,5 Z"
                                  StrokeThickness="1.75">
                                <Path.Triggers>
                                    <DataTrigger TargetType="Path" Binding="{Binding CurrentCard.IsSavedForLater}" Value="True">
                                        <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource LightBookmarkGold}, Dark={StaticResource DarkBookmarkGold}}"/>
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightBookmarkGold}, Dark={StaticResource DarkBookmarkGold}}"/>
                                    </DataTrigger>
                                </Path.Triggers>
                            </Path>
                        </Border>

                        <Border x:Name="CardOpenButton"
                                Style="{StaticResource IconButtonStyle}"
                                WidthRequest="68"
                                HeightRequest="68"
                                StrokeShape="RoundRectangle 34"
                                Background="{AppThemeBinding Light={StaticResource LightPrimaryContainer}, Dark={StaticResource DarkPrimary}}"
                                SemanticProperties.Description="{x:Static strings:AppResources.UnreadActionRead}"
                                SemanticProperties.Hint="{x:Static strings:AppResources.AccessibilityOpenArticle}">
                            <Border.Shadow>
                                <Shadow Brush="{AppThemeBinding Light={StaticResource LightCardShadow}, Dark={StaticResource DarkCardShadow}}"
                                        Opacity="0.22"
                                        Radius="16"
                                        Offset="0,6"/>
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCardOpenTapped"/>
                            </Border.GestureRecognizers>
                            <Path Style="{StaticResource IconPathStyle}"
                                  Data="M2,4 L8,4 A4,4 0 0,1 12,8 L12,21 A3,3 0 0,0 9,18 L2,18 Z M22,4 L16,4 A4,4 0 0,0 12,8 L12,21 A3,3 0 0,1 15,18 L22,18 Z"
                                  StrokeThickness="1.75"
                                  Stroke="{AppThemeBinding Light={StaticResource LightOnPrimary}, Dark={StaticResource DarkOnPrimary}}"/>
                        </Border>

                        <Border x:Name="CardDoneButton"
                                Style="{StaticResource IconButtonFilledStyle}"
                                WidthRequest="56"
                                HeightRequest="56"
                                StrokeShape="RoundRectangle 28"
                                SemanticProperties.Description="{x:Static strings:AppResources.ArticleMarkAsRead}"
                                SemanticProperties.Hint="{x:Static strings:AppResources.UnreadCardSwipeHint}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCardDoneTapped"/>
                            </Border.GestureRecognizers>
                            <Path Style="{StaticResource IconPathStyle}"
                                  Data="M20,6 L9,17 L4,12"
                                  StrokeThickness="2"/>
                        </Border>

                        <Border Style="{StaticResource IconButtonStyle}"
                                SemanticProperties.Description="{x:Static strings:AppResources.UnreadCardNext}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding CanGoToNextCard}" Value="False">
                                    <Setter Property="Opacity" Value="0.3"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCardNextTapped"/>
                            </Border.GestureRecognizers>
                            <Path Style="{StaticResource IconPathStyle}"
                                  Data="M9,18 L15,12 L9,6"
                                  StrokeThickness="2"
                                  Stroke="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"/>
                        </Border>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Grid>

            <!-- Lade-Skelett (nur beim ersten Laden ohne Inhalt) -->
            <views:ListSkeletonView IsVisible="{Binding ShowSkeleton}"/>

            <!-- Leerer Zustand -->
            <VerticalStackLayout x:Name="EmptyState"
                                 Padding="40,0,40,64"
                                 Spacing="12"
                                 VerticalOptions="Center"
                                 InputTransparent="True"
                                 IsVisible="{Binding ShowEmptyState}">
                <Border WidthRequest="76"
                        HeightRequest="76"
                        HorizontalOptions="Center"
                        StrokeThickness="0"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 38"
                        Background="{AppThemeBinding Light={StaticResource LightCoverTint}, Dark={StaticResource DarkCoverTint}}">
                    <Path Style="{StaticResource IconPathStyle}"
                          Data="M12,2 A10,10 0 1,1 12,22 A10,10 0 1,1 12,2 Z M8,12 L11,15 L16,9"
                          Scale="1.35"
                          StrokeThickness="1.4"
                          Stroke="{AppThemeBinding Light={StaticResource LightSwipeDone}, Dark={StaticResource DarkSwipeDone}}"/>
                </Border>
                <Label Text="{x:Static strings:AppResources.UnreadEmptyTitle}"
                       Style="{StaticResource DisplayTitleStyle}"
                       FontSize="32"
                       HorizontalTextAlignment="Center"
                       Margin="0,8,0,0"/>
                <Label Text="{x:Static strings:AppResources.UnreadEmptySubtitle}"
                       Style="{StaticResource RowSummaryStyle}"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
