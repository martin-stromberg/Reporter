<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Reporter.Core.Resources.Strings;assembly=Reporter.Core"
             x:Class="Reporter.Views.SettingsPage"
             Title="{x:Static strings:AppResources.PageTitleSettings}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*"
          Padding="16,8"
          RowSpacing="12">
        <Label Text="{x:Static strings:AppResources.PageTitleSettings}"
               Style="{StaticResource HeadlineStyle}"/>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12">
                <Border Padding="16"
                        StrokeShape="RoundRectangle 12"
                        Background="{AppThemeBinding Light={StaticResource LightSurfaceContainer}, Dark={StaticResource DarkSurfaceContainer}}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static strings:AppResources.PageTitleSettings}"
                               Style="{StaticResource HeadlineSmallStyle}"/>
                        <Label Text="{x:Static strings:AppResources.PlaceholderSettings}"
                               Style="{StaticResource BodySmallStyle}"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
