<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Reporter.Core.Resources.Strings;assembly=Reporter.Core"
             x:Class="Reporter.Views.CategoriesPage"
             Title="{x:Static strings:AppResources.PageTitleCategories}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*"
          Padding="16,8"
          RowSpacing="12">
        <VerticalStackLayout Spacing="12">
            <Label Text="{x:Static strings:AppResources.PageTitleCategories}"
                   Style="{StaticResource HeadlineStyle}"/>
            <Border Padding="16"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light={StaticResource LightBorderSubtle}, Dark={StaticResource DarkBorderSubtle}}"
                    Background="{AppThemeBinding Light={StaticResource LightSurfaceCard}, Dark={StaticResource DarkSurfaceCard}}">
                <VerticalStackLayout Spacing="12">
                    <Entry x:Name="CategoryNameEntry"
                           Text="{Binding NewCategoryName}"
                           Placeholder="{x:Static strings:AppResources.LabelCategoryName}"
                           SemanticProperties.Description="{x:Static strings:AppResources.LabelCategoryName}"
                           ReturnCommand="{Binding SaveCommand}"/>
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{AppThemeBinding Light={StaticResource LightError}, Dark={StaticResource DarkError}}"
                           IsVisible="{Binding HasError}"
                           Style="{StaticResource BodySmallStyle}"/>
                    <Button Text="{x:Static strings:AppResources.ButtonSave}"
                            Command="{Binding SaveCommand}"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Categories}"
                        EmptyView="{x:Static strings:AppResources.PlaceholderCategories}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="16"
                            Margin="0,6"
                            StrokeShape="RoundRectangle 12"
                            Stroke="{AppThemeBinding Light={StaticResource LightBorderSubtle}, Dark={StaticResource DarkBorderSubtle}}"
                            SemanticProperties.Description="{Binding Name}"
                            SemanticProperties.Hint="{x:Static strings:AppResources.AccessibilityTapForActions}"
                            Background="{AppThemeBinding Light={StaticResource LightSurfaceCard}, Dark={StaticResource DarkSurfaceCard}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCategoryTapped"
                                                  CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                            <VerticalStackLayout Spacing="4"
                                                   VerticalOptions="Center">
                                <Label Text="{Binding Name}"
                                       Style="{StaticResource HeadlineSmallStyle}"/>
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{x:Static strings:AppResources.LabelCategoryFeedCount}"
                                           Style="{StaticResource MetaStyle}"/>
                                    <Label Text="{Binding FeedCount}"
                                           Style="{StaticResource MetaStyle}"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
