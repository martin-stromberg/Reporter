<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Reporter.Resources.Strings;assembly=Reporter"
             xmlns:vm="clr-namespace:Reporter.ViewModels;assembly=Reporter"
             x:Class="Reporter.Views.FeedsPage"
             Title="{x:Static strings:AppResources.PageTitleFeeds}">
    <VerticalStackLayout Spacing="16" Padding="20">
        <Label Text="{x:Static strings:AppResources.PageTitleFeeds}"
               Style="{StaticResource HeadlineStyle}"
               HorizontalOptions="Center" />
        <Label Text="{Binding ErrorMessage}"
               TextColor="{AppThemeBinding Light={StaticResource LightError}, Dark={StaticResource DarkError}}"
               IsVisible="{Binding HasError}"
               HorizontalOptions="Center" />
        <Entry Text="{Binding NewUrl}"
               Placeholder="{x:Static strings:AppResources.PlaceholderFeedUrl}"
               Keyboard="Url"
               ReturnCommand="{Binding SaveCommand}" />
        <Entry Text="{Binding NewTitle}"
               Placeholder="{x:Static strings:AppResources.PlaceholderFeedTitle}"
               ReturnCommand="{Binding SaveCommand}" />
        <Picker ItemsSource="{Binding Categories}"
                SelectedItem="{Binding SelectedCategory}"
                Title="{x:Static strings:AppResources.LabelFeedCategory}"
                ItemDisplayBinding="{Binding Name}" />
        <Button Text="{x:Static strings:AppResources.ButtonSave}"
                Command="{Binding SaveCommand}" />
        <Button Text="{x:Static strings:AppResources.ButtonRefreshAll}"
                Command="{Binding RefreshAllCommand}" />
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              Padding="0,8">
            <Label Text="{x:Static strings:AppResources.LabelFeedTitle}"
                   Style="{StaticResource UiLabelStyle}" />
            <Label Text="{x:Static strings:AppResources.LabelFeedCategory}"
                   Style="{StaticResource UiLabelStyle}"
                   Grid.Column="1"
                   Margin="10,0" />
            <Label Text="{x:Static strings:AppResources.LabelFeedLastCheck}"
                   Style="{StaticResource UiLabelStyle}"
                   Grid.Column="2"
                   Margin="10,0" />
            <Label Text="{x:Static strings:AppResources.LabelFeedUnreadCount}"
                   Style="{StaticResource UiLabelStyle}"
                   Grid.Column="3"
                   Margin="10,0" />
            <Label Text="{x:Static strings:AppResources.LabelFeedHealthStatus}"
                   Style="{StaticResource UiLabelStyle}"
                   Grid.Column="4"
                   Margin="10,0" />
            <Label Text="{x:Static strings:AppResources.LabelFeedActions}"
                   Style="{StaticResource UiLabelStyle}"
                   Grid.Column="5"
                   Margin="10,0" />
        </Grid>
        <CollectionView ItemsSource="{Binding Feeds}"
                        HeightRequest="300">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          Padding="0,4">
                        <Label Text="{Binding Title}"
                               VerticalOptions="Center" />
                        <Label Text="{Binding CategoryName, TargetNullValue='—'}"
                               VerticalOptions="Center"
                               Grid.Column="1"
                               Margin="10,0" />
                        <Label Text="{Binding LastCheckedAt, StringFormat='{0:g}', TargetNullValue='—'}"
                               VerticalOptions="Center"
                               Grid.Column="2"
                               Margin="10,0" />
                        <Label Text="{Binding UnreadCount}"
                               VerticalOptions="Center"
                               Grid.Column="3"
                               Margin="10,0" />
                        <Label Text="{Binding HealthStatus, TargetNullValue='—'}"
                               VerticalOptions="Center"
                               Grid.Column="4"
                               Margin="10,0">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding HealthStatus}" Value="OK">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightStatusOk}, Dark={StaticResource DarkStatusOk}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding HealthStatus}" Value="Warning">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightStatusWarning}, Dark={StaticResource DarkStatusWarning}}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding HealthStatus}" Value="Error">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightStatusError}, Dark={StaticResource DarkStatusError}}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Button Text="{x:Static strings:AppResources.ButtonRefresh}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FeedsViewModel}}, Path=RefreshCommand}"
                                CommandParameter="{Binding .}"
                                Grid.Column="5" />
                        <Button Text="{x:Static strings:AppResources.ButtonEdit}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FeedsViewModel}}, Path=EditCommand}"
                                CommandParameter="{Binding .}"
                                Grid.Column="6" />
                        <Button Text="{x:Static strings:AppResources.ButtonDelete}"
                                Clicked="OnDeleteClicked"
                                Grid.Column="7" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
