<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Reporter.Core.Resources.Strings;assembly=Reporter.Core"
             xmlns:vm="clr-namespace:Reporter.Core.ViewModels;assembly=Reporter.Core"
             xmlns:models="clr-namespace:Reporter.Core.Models;assembly=Reporter.Core"
             x:Class="Reporter.Views.FeedsPage"
             x:Name="Page"
             x:DataType="vm:FeedsViewModel"
             Title="{x:Static strings:AppResources.PageTitleFeeds}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*"
          Padding="16,8"
          RowSpacing="12">
        <VerticalStackLayout Spacing="12">
            <Label Text="{x:Static strings:AppResources.PageTitleFeeds}"
                   Style="{StaticResource HeadlineStyle}"/>
            <Button Text="{x:Static strings:AppResources.ActionAddFeed}"
                    Command="{Binding OpenAddFormCommand}"
                    MinimumHeightRequest="44"/>
            <Label Text="{Binding ErrorMessage}"
                   TextColor="{AppThemeBinding Light={StaticResource LightError}, Dark={StaticResource DarkError}}"
                   IsVisible="{Binding HasError}"
                   Style="{StaticResource BodySmallStyle}"/>
            <Border Padding="10"
                    StrokeShape="RoundRectangle 8"
                    Stroke="Transparent"
                    IsVisible="False"
                    Background="{AppThemeBinding Light={StaticResource LightSurfaceSubtle}, Dark={StaticResource DarkSurfaceSubtle}}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsOnline}" Value="False">
                        <Setter Property="IsVisible" Value="True"/>
                    </DataTrigger>
                </Border.Triggers>
                <Label Text="{x:Static strings:AppResources.OfflineHint}"
                       Style="{StaticResource BodySmallStyle}"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"/>
            </Border>
            <Label Text="{x:Static strings:AppResources.FeedSearchOfflineHint}"
                   IsVisible="False"
                   Style="{StaticResource BodySmallStyle}"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsOnline}" Value="False">
                        <Setter Property="IsVisible" Value="True"/>
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Label Text="{Binding SearchErrorMessage}"
                   TextColor="{AppThemeBinding Light={StaticResource LightError}, Dark={StaticResource DarkError}}"
                   IsVisible="{Binding HasSearchError}"
                   Style="{StaticResource BodySmallStyle}"/>
            <Label Text="{Binding SyncErrorMessage}"
                   TextColor="{AppThemeBinding Light={StaticResource LightError}, Dark={StaticResource DarkError}}"
                   IsVisible="{Binding HasSyncError}"
                   Style="{StaticResource BodySmallStyle}"/>
        </VerticalStackLayout>

        <Grid Grid.Row="1"
              RowDefinitions="*,Auto,Auto"
              IsVisible="False">
            <Grid.Triggers>
                <DataTrigger TargetType="Grid" Binding="{Binding ShowSearchResults}" Value="True">
                    <Setter Property="IsVisible" Value="True"/>
                </DataTrigger>
            </Grid.Triggers>
            <CollectionView ItemsSource="{Binding SearchResults}"
                            EmptyView="{x:Static strings:AppResources.FeedSearchNoResults}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FeedSearchResult">
                        <Border Padding="16"
                                Margin="0,6"
                                MinimumHeightRequest="44"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource LightBorderSubtle}, Dark={StaticResource DarkBorderSubtle}}"
                                SemanticProperties.Description="{Binding DisplayTitle}"
                                SemanticProperties.Hint="{x:Static strings:AppResources.AccessibilityTapForActions}"
                                Background="{AppThemeBinding Light={StaticResource LightSurfaceCard}, Dark={StaticResource DarkSurfaceCard}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSearchResultTapped"
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding DisplayTitle}"
                                       Style="{StaticResource HeadlineSmallStyle}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2"/>
                                <Label Text="{Binding Description}"
                                       Style="{StaticResource BodySmallStyle}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="3">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Description, Converter={StaticResource StringNotEmptyToBoolConverter}}" Value="False">
                                            <Setter Property="IsVisible" Value="False"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding SiteName, TargetNullValue='—', FallbackValue='—'}"
                                           Style="{StaticResource MetaStyle}"/>
                                    <Label Text="•"
                                           Style="{StaticResource MetaStyle}"/>
                                    <Label Text="{Binding SiteUrl, TargetNullValue='—', FallbackValue='—'}"
                                           Style="{StaticResource MetaStyle}"
                                           LineBreakMode="TailTruncation"/>
                                </HorizontalStackLayout>
                                <Label Text="{Binding FeedUrl}"
                                       Style="{StaticResource BodySmallStyle}"
                                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                       LineBreakMode="TailTruncation">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Title, Converter={StaticResource StringNotEmptyToBoolConverter}}" Value="False">
                                            <Setter Property="IsVisible" Value="False"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Label Grid.Row="1"
                   Text="{x:Static strings:AppResources.FeedSearchAttribution}"
                   Style="{StaticResource MetaStyle}"
                   HorizontalOptions="Center"
                   Margin="0,4"/>
            <Button Grid.Row="2"
                    Text="{x:Static strings:AppResources.ButtonCloseSearchResults}"
                    Command="{Binding CloseSearchResultsCommand}"
                    MinimumHeightRequest="44"
                    Margin="0,4,0,0"/>
        </Grid>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsSyncing}"
                     Command="{Binding RefreshAllCommand}">
            <RefreshView.Triggers>
                <DataTrigger TargetType="RefreshView" Binding="{Binding ShowSearchResults}" Value="True">
                    <Setter Property="IsVisible" Value="False"/>
                </DataTrigger>
            </RefreshView.Triggers>
            <CollectionView ItemsSource="{Binding Feeds}"
                            EmptyView="{x:Static strings:AppResources.PlaceholderFeeds}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FeedListItem">
                        <Border Padding="16"
                                Margin="0,6"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource LightBorderSubtle}, Dark={StaticResource DarkBorderSubtle}}"
                                SemanticProperties.Description="{Binding Title}"
                                SemanticProperties.Hint="{x:Static strings:AppResources.AccessibilityOpenFeedDetails}"
                                Background="{AppThemeBinding Light={StaticResource LightSurfaceCard}, Dark={StaticResource DarkSurfaceCard}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFeedTapped"
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  ColumnDefinitions="Auto,*,Auto"
                                  RowSpacing="8"
                                  ColumnSpacing="12">
                                <Grid Grid.Row="0"
                                      Grid.RowSpan="2"
                                      Grid.Column="0"
                                      WidthRequest="40"
                                      HeightRequest="40"
                                      VerticalOptions="Center">
                                    <Image Source="{Binding FaviconUrl}"
                                           Aspect="AspectFit"
                                           WidthRequest="40"
                                           HeightRequest="40"
                                           IsVisible="False">
                                        <Image.Triggers>
                                            <MultiTrigger TargetType="Image">
                                                <MultiTrigger.Conditions>
                                                    <BindingCondition Binding="{Binding FaviconUrl, Converter={StaticResource StringNotEmptyToBoolConverter}}" Value="True"/>
                                                    <BindingCondition Binding="{Binding BindingContext.IsOnline, Source={x:Reference Page}}" Value="True"/>
                                                </MultiTrigger.Conditions>
                                                <Setter Property="IsVisible" Value="True"/>
                                            </MultiTrigger>
                                        </Image.Triggers>
                                    </Image>
                                    <Border StrokeShape="RoundRectangle 20"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            Background="{AppThemeBinding Light={StaticResource LightSurfaceContainer}, Dark={StaticResource DarkSurfaceContainer}}"
                                            IsVisible="False">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding FaviconUrl, Converter={StaticResource StringNotEmptyToBoolConverter}}" Value="False">
                                                <Setter Property="IsVisible" Value="True"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding BindingContext.IsOnline, Source={x:Reference Page}}" Value="False">
                                                <Setter Property="IsVisible" Value="True"/>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding FeedInitial}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Border>
                                </Grid>
                                <Label Grid.Column="1"
                                       Text="{Binding Title}"
                                       Style="{StaticResource HeadlineSmallStyle}"
                                       VerticalOptions="Center"/>
                                <BoxView WidthRequest="8"
                                         HeightRequest="8"
                                         CornerRadius="4"
                                         VerticalOptions="Center"
                                         HorizontalOptions="End"
                                         Grid.Column="2">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding HealthStatus}" Value="OK">
                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LightStatusOk}, Dark={StaticResource DarkStatusOk}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding HealthStatus}" Value="Warning">
                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LightStatusWarning}, Dark={StaticResource DarkStatusWarning}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding HealthStatus}" Value="Error">
                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LightStatusError}, Dark={StaticResource DarkStatusError}}" />
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>

                                <HorizontalStackLayout Grid.Row="1"
                                                       Grid.Column="1"
                                                       Spacing="8"
                                                       VerticalOptions="Center">
                                    <Label Text="{Binding CategoryName, TargetNullValue='—'}"
                                           Style="{StaticResource MetaStyle}"/>
                                    <Label Text="•"
                                           Style="{StaticResource MetaStyle}"/>
                                    <Label Text="{Binding LastCheckedAt, StringFormat='{0:g}', TargetNullValue='—'}"
                                           Style="{StaticResource MetaStyle}"/>
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Grid.Row="1"
                                                       Grid.Column="2"
                                                       Spacing="8"
                                                       VerticalOptions="Center">
                                    <Label Text="{x:Static strings:AppResources.LabelFeedUnreadCount}"
                                           Style="{StaticResource MetaStyle}"/>
                                    <Label Text="{Binding UnreadCount}"
                                           Style="{StaticResource MetaStyle}"/>
                                </HorizontalStackLayout>

                                <Border Grid.Row="2"
                                        Grid.ColumnSpan="3"
                                        Padding="8,2"
                                        StrokeShape="RoundRectangle 9999"
                                        Stroke="Transparent"
                                        HorizontalOptions="Start"
                                        Background="{AppThemeBinding Light={StaticResource LightStatusOkTint}, Dark={StaticResource DarkStatusOkTint}}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding HealthStatus}" Value="Warning">
                                            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource LightStatusWarningTint}, Dark={StaticResource DarkStatusWarningTint}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding HealthStatus}" Value="Error">
                                            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource LightStatusErrorTint}, Dark={StaticResource DarkStatusErrorTint}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <HorizontalStackLayout Spacing="6"
                                                           VerticalOptions="Center">
                                        <BoxView WidthRequest="6"
                                                 HeightRequest="6"
                                                 CornerRadius="3"
                                                 VerticalOptions="Center"
                                                 Color="{AppThemeBinding Light={StaticResource LightStatusOk}, Dark={StaticResource DarkStatusOk}}">
                                            <BoxView.Triggers>
                                                <DataTrigger TargetType="BoxView" Binding="{Binding HealthStatus}" Value="Warning">
                                                    <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LightStatusWarning}, Dark={StaticResource DarkStatusWarning}}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="BoxView" Binding="{Binding HealthStatus}" Value="Error">
                                                    <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LightStatusError}, Dark={StaticResource DarkStatusError}}" />
                                                </DataTrigger>
                                            </BoxView.Triggers>
                                        </BoxView>
                                        <Label Text="{x:Static strings:AppResources.HealthStatusOkLabel}"
                                               Style="{StaticResource LabelMetaStyle}"
                                               TextColor="{AppThemeBinding Light={StaticResource LightStatusOkText}, Dark={StaticResource DarkStatusOkText}}"
                                               VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding HealthStatus}" Value="Warning">
                                                    <Setter Property="Text" Value="{x:Static strings:AppResources.HealthStatusWarningLabel}" />
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightStatusWarningText}, Dark={StaticResource DarkStatusWarningText}}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding HealthStatus}" Value="Error">
                                                    <Setter Property="Text" Value="{x:Static strings:AppResources.HealthStatusErrorLabel}" />
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightStatusErrorText}, Dark={StaticResource DarkStatusErrorText}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Grid Grid.RowSpan="2"
              IsVisible="False">
            <Grid.Triggers>
                <DataTrigger TargetType="Grid" Binding="{Binding ShowAddForm}" Value="True">
                    <Setter Property="IsVisible" Value="True"/>
                </DataTrigger>
            </Grid.Triggers>
            <BoxView Opacity="0.5"
                     Color="{AppThemeBinding Light={StaticResource LightOnSurface}, Dark={StaticResource DarkSurface}}"
                     SemanticProperties.Description="{x:Static strings:AppResources.AccessibilityDismissSheet}">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseAddFormCommand}"/>
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border Padding="16"
                    VerticalOptions="End"
                    StrokeShape="RoundRectangle 12,12,0,0"
                    Background="{AppThemeBinding Light={StaticResource LightSurfaceContainerLowest}, Dark={StaticResource DarkSurfaceContainerLowest}}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <Label Text="{x:Static strings:AppResources.FeedAddSheetTitle}"
                               Style="{StaticResource HeadlineSmallStyle}"
                               VerticalOptions="Center"/>
                        <Button Grid.Column="1"
                                Text="{x:Static strings:AppResources.ButtonCancel}"
                                Command="{Binding CloseAddFormCommand}"
                                MinimumHeightRequest="44"/>
                    </Grid>
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{AppThemeBinding Light={StaticResource LightError}, Dark={StaticResource DarkError}}"
                           IsVisible="{Binding HasError}"
                           Style="{StaticResource BodySmallStyle}"/>
                    <Label Text="{Binding SearchErrorMessage}"
                           TextColor="{AppThemeBinding Light={StaticResource LightError}, Dark={StaticResource DarkError}}"
                           IsVisible="{Binding HasSearchError}"
                           Style="{StaticResource BodySmallStyle}"/>
                    <Label Text="{x:Static strings:AppResources.FeedSearchOfflineHint}"
                           IsVisible="False"
                           Style="{StaticResource BodySmallStyle}"
                           TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsOnline}" Value="False">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Entry x:Name="NewUrlEntry"
                           Text="{Binding NewUrl}"
                           Placeholder="{x:Static strings:AppResources.PlaceholderFeedSearch}"
                           SemanticProperties.Description="{x:Static strings:AppResources.PlaceholderFeedSearch}"
                           Keyboard="Url"
                           ReturnCommand="{Binding SearchCommand}"/>
                    <ActivityIndicator IsVisible="{Binding IsSearching}"
                                       IsRunning="{Binding IsSearching}"
                                       HorizontalOptions="Center"/>
                    <Button Text="{x:Static strings:AppResources.ButtonSearch}"
                            Command="{Binding SearchCommand}"
                            MinimumHeightRequest="44"/>
                    <Button Text="{x:Static strings:AppResources.ButtonDirectAdd}"
                            Command="{Binding DirectAddCommand}"
                            MinimumHeightRequest="44"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
