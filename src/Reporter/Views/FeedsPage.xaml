<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Reporter.Core.Resources.Strings;assembly=Reporter.Core"
             xmlns:vm="clr-namespace:Reporter.Core.ViewModels;assembly=Reporter.Core"
             x:Class="Reporter.Views.FeedsPage"
             Title="{x:Static strings:AppResources.PageTitleFeeds}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*"
          Padding="16,8"
          RowSpacing="12">
        <VerticalStackLayout Spacing="12">
            <Label Text="{x:Static strings:AppResources.PageTitleFeeds}"
                   Style="{StaticResource HeadlineStyle}"/>
            <Border Padding="16"
                    StrokeShape="RoundRectangle 12"
                    Background="{AppThemeBinding Light={StaticResource LightSurfaceContainer}, Dark={StaticResource DarkSurfaceContainer}}">
                <VerticalStackLayout Spacing="12">
                    <Entry Text="{Binding NewUrl}"
                           Placeholder="{x:Static strings:AppResources.PlaceholderFeedSearch}"
                           Keyboard="Url"
                           ReturnCommand="{Binding SearchCommand}"/>
                    <Entry Text="{Binding NewTitle}"
                           Placeholder="{x:Static strings:AppResources.PlaceholderFeedTitle}"
                           ReturnCommand="{Binding SaveCommand}"/>
                    <Picker ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding SelectedCategory}"
                            Title="{x:Static strings:AppResources.LabelFeedCategory}"
                            ItemDisplayBinding="{Binding Name}"/>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8"
                          IsEnabled="{Binding NotificationsSupported}">
                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding NotificationsSupported}" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </DataTrigger>
                        </Grid.Triggers>
                        <VerticalStackLayout VerticalOptions="Center"
                                             Spacing="2">
                            <Label Text="{x:Static strings:AppResources.FeedNotificationsLabel}"/>
                            <Label Text="{x:Static strings:AppResources.FeedNotificationsHint}"
                                   Style="{StaticResource MetaStyle}"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding FeedNotificationsEnabled}"
                                SemanticProperties.Description="{x:Static strings:AppResources.FeedNotificationsLabel}"
                                MinimumWidthRequest="44"
                                MinimumHeightRequest="44"
                                VerticalOptions="Center"/>
                    </Grid>
                    <Border Padding="10"
                            StrokeShape="RoundRectangle 8"
                            Stroke="Transparent"
                            IsVisible="False"
                            Background="{AppThemeBinding Light={StaticResource LightSurfaceSubtle}, Dark={StaticResource DarkSurfaceSubtle}}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding NotificationsSupported}" Value="False">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{x:Static strings:AppResources.NotificationsIosOnlyHint}"
                               Style="{StaticResource BodySmallStyle}"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"/>
                    </Border>
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{AppThemeBinding Light={StaticResource LightError}, Dark={StaticResource DarkError}}"
                           IsVisible="{Binding HasError}"
                           Style="{StaticResource BodySmallStyle}"/>
                    <ActivityIndicator IsVisible="{Binding IsSearching}"
                                       IsRunning="{Binding IsSearching}"
                                       HorizontalOptions="Center"/>
                    <Button Text="{x:Static strings:AppResources.ButtonSearch}"
                            Command="{Binding SearchCommand}"/>
                    <Button Text="{x:Static strings:AppResources.ButtonSave}"
                            Command="{Binding SaveCommand}"/>
                </VerticalStackLayout>
            </Border>
            <Border Padding="10"
                    StrokeShape="RoundRectangle 8"
                    Stroke="Transparent"
                    IsVisible="False"
                    Background="{AppThemeBinding Light={StaticResource LightSurfaceSubtle}, Dark={StaticResource DarkSurfaceSubtle}}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsOnline}" Value="False">
                        <Setter Property="IsVisible" Value="True"/>
                    </DataTrigger>
                </Border.Triggers>
                <Label Text="{x:Static strings:AppResources.OfflineHint}"
                       Style="{StaticResource BodySmallStyle}"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"/>
            </Border>
            <Label Text="{x:Static strings:AppResources.FeedSearchOfflineHint}"
                   IsVisible="False"
                   Style="{StaticResource BodySmallStyle}"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsOnline}" Value="False">
                        <Setter Property="IsVisible" Value="True"/>
                    </DataTrigger>
                </Label.Triggers>
            </Label>
            <Label Text="{Binding SearchErrorMessage}"
                   TextColor="{AppThemeBinding Light={StaticResource LightError}, Dark={StaticResource DarkError}}"
                   IsVisible="{Binding HasSearchError}"
                   Style="{StaticResource BodySmallStyle}"/>
            <Label Text="{Binding SyncErrorMessage}"
                   TextColor="{AppThemeBinding Light={StaticResource LightError}, Dark={StaticResource DarkError}}"
                   IsVisible="{Binding HasSyncError}"
                   Style="{StaticResource BodySmallStyle}"/>
        </VerticalStackLayout>

        <Grid Grid.Row="1"
              RowDefinitions="*,Auto,Auto"
              IsVisible="False">
            <Grid.Triggers>
                <DataTrigger TargetType="Grid" Binding="{Binding ShowSearchResults}" Value="True">
                    <Setter Property="IsVisible" Value="True"/>
                </DataTrigger>
            </Grid.Triggers>
            <CollectionView ItemsSource="{Binding SearchResults}"
                            EmptyView="{x:Static strings:AppResources.FeedSearchNoResults}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16"
                                Margin="0,6"
                                MinimumHeightRequest="44"
                                StrokeShape="RoundRectangle 12"
                                Background="{AppThemeBinding Light={StaticResource LightSurfaceContainer}, Dark={StaticResource DarkSurfaceContainer}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSearchResultTapped"
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding FeedUrl}"
                                       Style="{StaticResource HeadlineSmallStyle}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Title, Converter={StaticResource StringNotEmptyToBoolConverter}}" Value="True">
                                            <Setter Property="Text" Value="{Binding Title}"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding Description}"
                                       Style="{StaticResource BodySmallStyle}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="3">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Description, Converter={StaticResource StringNotEmptyToBoolConverter}}" Value="False">
                                            <Setter Property="IsVisible" Value="False"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding SiteName, TargetNullValue='—', FallbackValue='—'}"
                                           Style="{StaticResource MetaStyle}"/>
                                    <Label Text="•"
                                           Style="{StaticResource MetaStyle}"/>
                                    <Label Text="{Binding SiteUrl, TargetNullValue='—', FallbackValue='—'}"
                                           Style="{StaticResource MetaStyle}"
                                           LineBreakMode="TailTruncation"/>
                                </HorizontalStackLayout>
                                <Label Text="{Binding FeedUrl}"
                                       Style="{StaticResource BodySmallStyle}"
                                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                       LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Label Grid.Row="1"
                   Text="{x:Static strings:AppResources.FeedSearchAttribution}"
                   Style="{StaticResource MetaStyle}"
                   HorizontalOptions="Center"
                   Margin="0,4"/>
            <Button Grid.Row="2"
                    Text="{x:Static strings:AppResources.ButtonCloseSearchResults}"
                    Command="{Binding CloseSearchResultsCommand}"
                    MinimumHeightRequest="44"
                    Margin="0,4,0,0"/>
        </Grid>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsSyncing}"
                     Command="{Binding RefreshAllCommand}">
            <RefreshView.Triggers>
                <DataTrigger TargetType="RefreshView" Binding="{Binding ShowSearchResults}" Value="True">
                    <Setter Property="IsVisible" Value="False"/>
                </DataTrigger>
            </RefreshView.Triggers>
            <CollectionView ItemsSource="{Binding Feeds}"
                            EmptyView="{x:Static strings:AppResources.PlaceholderFeeds}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16"
                                Margin="0,6"
                                StrokeShape="RoundRectangle 12"
                                Background="{AppThemeBinding Light={StaticResource LightSurfaceContainer}, Dark={StaticResource DarkSurfaceContainer}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFeedTapped"
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  ColumnDefinitions="*,Auto"
                                  RowSpacing="8"
                                  ColumnSpacing="8">
                                <Label Text="{Binding Title}"
                                       Style="{StaticResource HeadlineSmallStyle}"
                                       VerticalOptions="Center"/>
                                <BoxView WidthRequest="12"
                                         HeightRequest="12"
                                         CornerRadius="6"
                                         VerticalOptions="Center"
                                         HorizontalOptions="End"
                                         Grid.Column="1">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding HealthStatus}" Value="OK">
                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LightStatusOk}, Dark={StaticResource DarkStatusOk}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding HealthStatus}" Value="Warning">
                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LightStatusWarning}, Dark={StaticResource DarkStatusWarning}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding HealthStatus}" Value="Error">
                                            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource LightStatusError}, Dark={StaticResource DarkStatusError}}" />
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>

                                <HorizontalStackLayout Grid.Row="1"
                                                       Spacing="8"
                                                       VerticalOptions="Center">
                                    <Label Text="{Binding CategoryName, TargetNullValue='—'}"
                                           Style="{StaticResource MetaStyle}"/>
                                    <Label Text="•"
                                           Style="{StaticResource MetaStyle}"/>
                                    <Label Text="{Binding LastCheckedAt, StringFormat='{0:g}', TargetNullValue='—'}"
                                           Style="{StaticResource MetaStyle}"/>
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Grid.Row="1"
                                                       Grid.Column="1"
                                                       Spacing="8"
                                                       VerticalOptions="Center">
                                    <Label Text="{x:Static strings:AppResources.LabelFeedUnreadCount}"
                                           Style="{StaticResource MetaStyle}"/>
                                    <Label Text="{Binding UnreadCount}"
                                           Style="{StaticResource MetaStyle}"/>
                                </HorizontalStackLayout>

                                <Label Grid.Row="2"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding HealthStatus}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding HealthStatus}" Value="OK">
                                            <Setter Property="Text" Value="{x:Static strings:AppResources.HealthStatusOkLabel}" />
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightStatusOk}, Dark={StaticResource DarkStatusOk}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding HealthStatus}" Value="Warning">
                                            <Setter Property="Text" Value="{x:Static strings:AppResources.HealthStatusWarningLabel}" />
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightStatusWarning}, Dark={StaticResource DarkStatusWarning}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding HealthStatus}" Value="Error">
                                            <Setter Property="Text" Value="{x:Static strings:AppResources.HealthStatusErrorLabel}" />
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightStatusError}, Dark={StaticResource DarkStatusError}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
