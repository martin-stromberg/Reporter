<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Reporter.Core.Resources.Strings;assembly=Reporter.Core"
             xmlns:vm="clr-namespace:Reporter.Core.ViewModels;assembly=Reporter"
             x:Class="Reporter.Views.ArticleDetailPage"
             x:DataType="vm:ArticleDetailViewModel"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="All"
             Title="{Binding Item.Title, TargetNullValue={x:Static strings:AppResources.ArticleTitleFallback}}">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
          Padding="0"
          RowSpacing="0">
        <!-- Status pill -->
        <Grid Grid.Row="0"
              Padding="16,12,16,0"
              ColumnDefinitions="*,Auto">
            <HorizontalStackLayout Grid.Column="0"
                                   Spacing="6"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding Item.IsRead, FallbackValue=False}">
                <BoxView WidthRequest="8"
                         HeightRequest="8"
                         CornerRadius="4"
                         Color="{AppThemeBinding Light={StaticResource LightStatusOk}, Dark={StaticResource DarkStatusOk}}"
                         VerticalOptions="Center"/>
                <Label Text="{x:Static strings:AppResources.ArticleReadLabel}"
                       Style="{StaticResource MetaStyle}"
                       TextColor="{AppThemeBinding Light={StaticResource LightStatusOk}, Dark={StaticResource DarkStatusOk}}"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="1"
                                   Spacing="6"
                                   VerticalOptions="Center">
                <Label Text="{Binding AutoMarkReadLabel}"
                       Style="{StaticResource MetaStyle}"
                       VerticalOptions="Center"/>
                <Switch IsToggled="{Binding IsAutoMarkRead, Mode=TwoWay}"
                        IsEnabled="{Binding IsAutoMarkReadAvailable}"
                        OnColor="{AppThemeBinding Light={StaticResource LightSecondary}, Dark={StaticResource DarkSecondary}}"
                        ThumbColor="{AppThemeBinding Light={StaticResource LightOnSecondary}, Dark={StaticResource DarkOnSecondary}}"
                        MinimumHeightRequest="44"
                        MinimumWidthRequest="44"
                        VerticalOptions="Center"
                        SemanticProperties.Description="{Binding AutoMarkReadLabel}">
                    <Switch.Triggers>
                        <DataTrigger TargetType="Switch" Binding="{Binding IsAutoMarkReadAvailable}" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </DataTrigger>
                    </Switch.Triggers>
                </Switch>
            </HorizontalStackLayout>
        </Grid>

        <!-- Header -->
        <VerticalStackLayout Grid.Row="1"
                             Padding="16,8"
                             Spacing="4">
            <FlexLayout Wrap="Wrap"
                        Direction="Row"
                        JustifyContent="Start"
                        AlignItems="Center"
                        AlignContent="Start">
                <Image Source="{Binding FeedIconUrl}"
                       IsVisible="{Binding FeedIconUrl, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                       WidthRequest="16"
                       HeightRequest="16"
                       Margin="0,0,6,0"
                       VerticalOptions="Center"/>
                <BoxView WidthRequest="8"
                         HeightRequest="8"
                         CornerRadius="4"
                         Color="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}"
                         Margin="0,0,8,0"
                         VerticalOptions="Center"/>
                <Label Text="{Binding FeedName}"
                       Style="{StaticResource MetaStyle}"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"
                       MaxLines="1"
                       Margin="0,0,4,0"/>
                <Label Text="•"
                       Style="{StaticResource MetaStyle}"
                       VerticalOptions="Center"
                       Margin="0,0,4,0"/>
                <Label Text="{Binding PublishedAtText}"
                       Style="{StaticResource MetaStyle}"
                       VerticalOptions="Center"
                       Margin="0,0,4,0"/>
                <Label Text="•"
                       Style="{StaticResource MetaStyle}"
                       VerticalOptions="Center"
                       IsVisible="{Binding ReadingTime, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                       Margin="0,0,4,0"/>
                <Label Text="{Binding ReadingTime}"
                       Style="{StaticResource MetaStyle}"
                       VerticalOptions="Center"
                       IsVisible="{Binding ReadingTime, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                       MaxLines="1"
                       LineBreakMode="TailTruncation"/>
            </FlexLayout>
            <Label Text="{Binding Item.Title}"
                   Style="{StaticResource HeadlineSmallStyle}"
                   LineBreakMode="WordWrap"
                   MaxLines="0"/>
        </VerticalStackLayout>

        <!-- Offline hint + error message -->
        <VerticalStackLayout Grid.Row="2"
                             Padding="16,4"
                             Spacing="8">
            <Border Padding="10"
                    StrokeShape="RoundRectangle 8"
                    Stroke="Transparent"
                    IsVisible="False"
                    Background="{AppThemeBinding Light={StaticResource LightSurfaceSubtle}, Dark={StaticResource DarkSurfaceSubtle}}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsOnline}" Value="False">
                        <Setter Property="IsVisible" Value="True"/>
                    </DataTrigger>
                </Border.Triggers>
                <Label Text="{x:Static strings:AppResources.ArticleOfflineLinksDisabled}"
                       Style="{StaticResource BodySmallStyle}"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"/>
            </Border>
            <Label Text="{Binding ErrorMessage}"
                   TextColor="{AppThemeBinding Light={StaticResource LightError}, Dark={StaticResource DarkError}}"
                   IsVisible="{Binding HasError}"
                   Style="{StaticResource BodySmallStyle}"/>
        </VerticalStackLayout>

        <!-- Source footer. Declared before the WebView so it stays reachable in the
             Windows UI Automation control tree (WebView2 subtrees can cut off
             enumeration of later siblings). -->
        <Border Grid.Row="4"
                Padding="16,12"
                Margin="16,8"
                StrokeShape="RoundRectangle 12"
                Background="{AppThemeBinding Light={StaticResource LightSurfaceCard}, Dark={StaticResource DarkSurfaceCard}}"
                Stroke="{AppThemeBinding Light={StaticResource LightBorderSubtle}, Dark={StaticResource DarkBorderSubtle}}">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0"
                                     VerticalOptions="Center">
                    <Label Text="{x:Static strings:AppResources.ArticleFullContentAvailable}"
                           Style="{StaticResource BodySmallStyle}"
                           LineBreakMode="WordWrap"
                           MaxLines="2"/>
                    <Label Text="{Binding Item.Link}"
                           Style="{StaticResource MetaStyle}"
                           MaxLines="1"
                           LineBreakMode="TailTruncation"
                           IsVisible="{Binding Item.Link, Converter={StaticResource StringNotEmptyToBoolConverter}}"/>
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="{x:Static strings:AppResources.ArticleOpenInBrowser}"
                        Command="{Binding OpenInBrowserCommand}"
                        MinimumHeightRequest="44"
                        MinimumWidthRequest="44"
                        VerticalOptions="Center"
                        HorizontalOptions="End"/>
            </Grid>
        </Border>

        <!-- Floating reader control bar. Also declared before the WebView and built
             from real Button controls so the actions appear in the UIA control tree.
             The Path/Label elements only paint the icon; the transparent Button on
             top supplies the native automation peer and the 44×44 touch target. -->
        <Border Grid.Row="5"
                Margin="16,0,16,12"
                StrokeShape="RoundRectangle 26"
                Stroke="{AppThemeBinding Light={StaticResource LightBorderSubtle}, Dark={StaticResource DarkBorderSubtle}}"
                Background="{AppThemeBinding Light={StaticResource LightSurfaceCardTranslucent}, Dark={StaticResource DarkSurfaceCardTranslucent}}">
            <Border.Shadow>
                <Shadow Brush="Black"
                        Offset="0,4"
                        Radius="16"
                        Opacity="0.12"/>
            </Border.Shadow>
            <Grid Padding="8,4"
                  ColumnDefinitions="*,*,*,*,*,*">
            <Grid Grid.Column="0"
                  WidthRequest="44"
                  HeightRequest="44"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Path Data="M18,8 L10,16 L18,24"
                      Stroke="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                      StrokeThickness="2"
                      StrokeLineCap="Round"
                      StrokeLineJoin="Round"
                      Aspect="Uniform"
                      WidthRequest="22"
                      HeightRequest="22"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      InputTransparent="True"
                      Fill="Transparent"/>
                <Button Command="{Binding GoBackCommand}"
                        SemanticProperties.Description="{x:Static strings:AppResources.AccessibilityBack}"
                        Background="Transparent"
                        Padding="0"
                        CornerRadius="22"/>
            </Grid>
            <Grid Grid.Column="1"
                  WidthRequest="44"
                  HeightRequest="44"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Path Data="M6,4 L22,4 L22,26 L14,20 L6,26 Z"
                      Stroke="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                      StrokeThickness="2"
                      StrokeLineCap="Round"
                      StrokeLineJoin="Round"
                      Aspect="Uniform"
                      WidthRequest="18"
                      HeightRequest="18"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      InputTransparent="True"
                      Fill="Transparent">
                    <Path.Triggers>
                        <DataTrigger TargetType="Path" Binding="{Binding Item.IsSavedForLater}" Value="True">
                            <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource LightBookmarkGold}, Dark={StaticResource DarkBookmarkGold}}"/>
                        </DataTrigger>
                    </Path.Triggers>
                </Path>
                <Button Command="{Binding ToggleSavedForLaterCommand}"
                        SemanticProperties.Description="{Binding BookmarkButtonLabel}"
                        Background="Transparent"
                        Padding="0"
                        CornerRadius="22"/>
            </Grid>
            <Grid Grid.Column="2"
                  WidthRequest="44"
                  HeightRequest="44"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label Text="{Binding FontSizeLabel}"
                       Style="{StaticResource UiLabelStyle}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       InputTransparent="True"/>
                <Button Command="{Binding ToggleFontSizeCommand}"
                        SemanticProperties.Description="{x:Static strings:AppResources.AccessibilityFontSize}"
                        Background="Transparent"
                        Padding="0"
                        CornerRadius="22"/>
            </Grid>
            <Grid Grid.Column="3"
                  WidthRequest="44"
                  HeightRequest="44"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Path Data="M4,14 L12,22 L26,8"
                      Stroke="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                      StrokeThickness="2"
                      StrokeLineCap="Round"
                      StrokeLineJoin="Round"
                      Aspect="Uniform"
                      WidthRequest="18"
                      HeightRequest="18"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      InputTransparent="True"
                      Fill="Transparent">
                    <Path.Triggers>
                        <DataTrigger TargetType="Path" Binding="{Binding Item.IsRead}" Value="True">
                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightPrimary}, Dark={StaticResource DarkPrimary}}"/>
                        </DataTrigger>
                    </Path.Triggers>
                </Path>
                <Button Command="{Binding ToggleMarkReadCommand}"
                        SemanticProperties.Description="{Binding MarkAsReadButtonLabel}"
                        Background="Transparent"
                        Padding="0"
                        CornerRadius="22"/>
            </Grid>
            <Grid Grid.Column="4"
                  WidthRequest="44"
                  HeightRequest="44"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Path Data="M20,8 L30,16 L20,24 M30,16 L8,16"
                      Stroke="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                      StrokeThickness="2"
                      StrokeLineCap="Round"
                      StrokeLineJoin="Round"
                      Aspect="Uniform"
                      WidthRequest="22"
                      HeightRequest="22"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      InputTransparent="True"
                      Fill="Transparent"/>
                <Button Command="{Binding ShareCommand}"
                        SemanticProperties.Description="{x:Static strings:AppResources.AccessibilityShare}"
                        Background="Transparent"
                        Padding="0"
                        CornerRadius="22"/>
            </Grid>
            <Grid Grid.Column="5"
                  WidthRequest="44"
                  HeightRequest="44"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Path Data="M2,8 L30,8 M2,8 L2,28 L30,28 L30,8 M8,4 L8,8"
                      Stroke="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                      StrokeThickness="2"
                      StrokeLineCap="Round"
                      StrokeLineJoin="Round"
                      Aspect="Uniform"
                      WidthRequest="22"
                      HeightRequest="22"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      InputTransparent="True"
                      Fill="Transparent"/>
                <Button Command="{Binding OpenInBrowserCommand}"
                        SemanticProperties.Description="{x:Static strings:AppResources.ArticleOpenInBrowser}"
                        Background="Transparent"
                        Padding="0"
                        CornerRadius="22"/>
            </Grid>
            </Grid>
        </Border>

        <!-- WebView -->
        <WebView Grid.Row="3"
                 x:Name="ArticleWebView"
                 Navigating="OnWebViewNavigating"
                 VerticalOptions="Fill"
                 HorizontalOptions="Fill">
            <WebView.Source>
                <HtmlWebViewSource Html="{Binding HtmlSource}"/>
            </WebView.Source>
        </WebView>
    </Grid>
</ContentPage>
