<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Reporter.Core.Resources.Strings;assembly=Reporter.Core"
             x:Name="Card"
             x:Class="Reporter.Views.ArticleCardView">
    <Border Padding="16"
            Margin="0,6"
            StrokeShape="RoundRectangle 16"
            Background="{AppThemeBinding Light={StaticResource LightSurfaceCard}, Dark={StaticResource DarkSurfaceCard}}"
            Stroke="{AppThemeBinding Light={StaticResource LightBorderSubtle}, Dark={StaticResource DarkBorderSubtle}}">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
              ColumnDefinitions="*,Auto"
              RowSpacing="10"
              ColumnSpacing="14">
            <HorizontalStackLayout Grid.Row="0"
                                   Grid.Column="0"
                                   Spacing="8"
                                   VerticalOptions="Center">
                <BoxView WidthRequest="6"
                         HeightRequest="6"
                         CornerRadius="3"
                         BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondary}, Dark={StaticResource DarkSecondary}}"
                         IsVisible="False"
                         VerticalOptions="Center">
                    <BoxView.Triggers>
                        <DataTrigger TargetType="BoxView" Binding="{Binding IsRead}" Value="False">
                            <Setter Property="IsVisible" Value="True"/>
                        </DataTrigger>
                    </BoxView.Triggers>
                </BoxView>
                <Label Text="{Binding FeedTitle}"
                       Style="{StaticResource BodySmallStyle}"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"
                       MaxLines="1"/>
                <Label Text="•"
                       Style="{StaticResource MetaStyle}"
                       VerticalOptions="Center"/>
                <Label Text="{Binding PublishedAt, StringFormat='{0:g}', TargetNullValue='—'}"
                       Style="{StaticResource MetaStyle}"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <Border Grid.Row="0"
                    Grid.Column="1"
                    Padding="8,3"
                    StrokeShape="RoundRectangle 10"
                    Background="{AppThemeBinding Light={StaticResource LightSurfaceContainer}, Dark={StaticResource DarkSurfaceContainer}}"
                    VerticalOptions="Center">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding CategoryName}" Value="">
                        <Setter Property="IsVisible" Value="False"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding CategoryName}" Value="{x:Null}">
                        <Setter Property="IsVisible" Value="False"/>
                    </DataTrigger>
                </Border.Triggers>
                <Label Text="{Binding CategoryName}"
                       FontSize="11"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                       VerticalOptions="Center"
                       FontAttributes="Bold"/>
            </Border>

            <Label Grid.Row="1"
                   Grid.Column="0"
                   Text="{Binding Title}"
                   Style="{StaticResource HeadlineSmallStyle}"
                   LineBreakMode="TailTruncation"
                   MaxLines="2"
                   VerticalOptions="Start"/>

            <Border Grid.Row="1"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    WidthRequest="80"
                    HeightRequest="80"
                    StrokeShape="RoundRectangle 12"
                    Background="{AppThemeBinding Light={StaticResource LightSurfaceContainer}, Dark={StaticResource DarkSurfaceContainer}}"
                    VerticalOptions="Start">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsOnline, Source={x:Reference Card}}" Value="False">
                        <Setter Property="IsVisible" Value="False"/>
                    </DataTrigger>
                </Border.Triggers>
                <Grid>
                    <Image Source="{Binding ImageUrl}"
                           Aspect="AspectFill"
                           WidthRequest="80"
                           HeightRequest="80"
                           IsVisible="{Binding ImageUrl, Converter={StaticResource StringNotEmptyToBoolConverter}}"/>
                    <Image Source="{Binding FeedFaviconUrl}"
                           Aspect="AspectFit"
                           WidthRequest="48"
                           HeightRequest="48"
                           IsVisible="False">
                        <Image.Triggers>
                            <MultiTrigger TargetType="Image">
                                <MultiTrigger.Conditions>
                                    <BindingCondition Binding="{Binding FeedFaviconUrl, Converter={StaticResource StringNotEmptyToBoolConverter}}" Value="True"/>
                                    <BindingCondition Binding="{Binding ImageUrl, Converter={StaticResource StringNotEmptyToBoolConverter}}" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="IsVisible" Value="True"/>
                            </MultiTrigger>
                        </Image.Triggers>
                    </Image>
                    <Border StrokeShape="RoundRectangle 40"
                            WidthRequest="80"
                            HeightRequest="80"
                            Background="{AppThemeBinding Light={StaticResource LightSurfaceCard}, Dark={StaticResource DarkSurfaceCard}}"
                            IsVisible="False">
                        <Border.Triggers>
                            <MultiTrigger TargetType="Border">
                                <MultiTrigger.Conditions>
                                    <BindingCondition Binding="{Binding ImageUrl, Converter={StaticResource StringNotEmptyToBoolConverter}}" Value="False"/>
                                    <BindingCondition Binding="{Binding FeedFaviconUrl, Converter={StaticResource StringNotEmptyToBoolConverter}}" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="IsVisible" Value="True"/>
                            </MultiTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding FeedInitial}"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Label Grid.Row="2"
                   Grid.Column="0"
                   Text="{Binding Summary}"
                   Style="{StaticResource BodySmallStyle}"
                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                   LineBreakMode="TailTruncation"
                   MaxLines="2"
                   IsVisible="{Binding Summary, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                   VerticalOptions="Start"/>

            <Grid Grid.Row="3"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  ColumnDefinitions="*,Auto"
                  RowDefinitions="Auto">
                <HorizontalStackLayout Grid.Column="0"
                                       Spacing="4"
                                       IsVisible="{Binding ReadingTimeText, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                                       VerticalOptions="Center">
                    <Path Data="M24,4 A20,20 0 1,1 24,44 A20,20 0 1,1 24,4 Z M24,14 L24,26 M24,26 L18,20 M24,26 L30,20"
                          Stroke="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                          StrokeThickness="2"
                          StrokeLineCap="Round"
                          StrokeLineJoin="Round"
                          Aspect="Uniform"
                          WidthRequest="16"
                          HeightRequest="16"
                          VerticalOptions="Center"
                          Fill="Transparent"/>
                    <Label Text="{Binding ReadingTimeText}"
                           Style="{StaticResource MetaStyle}"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Column="1"
                                       Spacing="8"
                                       VerticalOptions="Center">
                    <Border WidthRequest="44"
                            HeightRequest="44"
                            StrokeShape="RoundRectangle 22"
                            Background="Transparent"
                            SemanticProperties.Description="{x:Static strings:AppResources.ArticleBookmarkSet}"
                            VerticalOptions="Center">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSavedForLater}" Value="True">
                                <Setter Property="SemanticProperties.Description" Value="{x:Static strings:AppResources.ArticleBookmarkRemove}"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleSavedCommand, Source={x:Reference Card}}"
                                                  CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                        <Path Data="M6,4 L22,4 L22,26 L14,20 L6,26 Z"
                              Stroke="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                              StrokeThickness="2"
                              StrokeLineCap="Round"
                              StrokeLineJoin="Round"
                              Aspect="Uniform"
                              WidthRequest="18"
                              HeightRequest="18"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Fill="Transparent">
                            <Path.Triggers>
                                <DataTrigger TargetType="Path" Binding="{Binding IsSavedForLater}" Value="True">
                                    <Setter Property="Fill" Value="{AppThemeBinding Light={StaticResource LightBookmarkGold}, Dark={StaticResource DarkBookmarkGold}}"/>
                                </DataTrigger>
                            </Path.Triggers>
                        </Path>
                    </Border>

                    <Border WidthRequest="44"
                            HeightRequest="44"
                            StrokeShape="RoundRectangle 22"
                            Background="Transparent"
                            SemanticProperties.Description="{x:Static strings:AppResources.ArticleMarkAsRead}"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding MarkReadCommand, Source={x:Reference Card}}"
                                                  CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                        <Path Data="M4,14 L12,22 L26,8"
                              Stroke="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                              StrokeThickness="2"
                              StrokeLineCap="Round"
                              StrokeLineJoin="Round"
                              Aspect="Uniform"
                              WidthRequest="18"
                              HeightRequest="18"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Fill="Transparent"/>
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <Grid Grid.Row="0"
                  Grid.RowSpan="3"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  Background="Transparent"
                  SemanticProperties.Description="{Binding Title}"
                  SemanticProperties.Hint="{x:Static strings:AppResources.AccessibilityOpenArticle}">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenArticleCommand, Source={x:Reference Card}}"
                                          CommandParameter="{Binding .}"/>
                </Grid.GestureRecognizers>
            </Grid>
        </Grid>
    </Border>
</ContentView>
