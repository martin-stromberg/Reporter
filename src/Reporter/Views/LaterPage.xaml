<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:Reporter.Core.Resources.Strings;assembly=Reporter.Core"
             x:Class="Reporter.Views.LaterPage"
             Title="{x:Static strings:AppResources.PageTitleLater}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*"
          Padding="16,8"
          RowSpacing="12">
        <Label Text="{x:Static strings:AppResources.PageTitleLater}"
               Style="{StaticResource HeadlineStyle}"/>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding SavedItems}"
                        EmptyView="{x:Static strings:AppResources.PlaceholderLater}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="16"
                            Margin="0,6"
                            StrokeShape="RoundRectangle 12"
                            Background="{AppThemeBinding Light={StaticResource LightSurfaceContainer}, Dark={StaticResource DarkSurfaceContainer}}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Title}"
                                   Style="{StaticResource HeadlineSmallStyle}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2"/>
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding PublishedAt, StringFormat='{0:g}', TargetNullValue='—'}"
                                       Style="{StaticResource MetaStyle}"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
